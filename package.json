{
  "name": "ai-for-all",
  "productName": "AI for All",
  "version": "1.0.0",
  "private": true,
  "description": "Turn what your computer has into AI access for everyone.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && AFA_DEV=1 electron .\"",
